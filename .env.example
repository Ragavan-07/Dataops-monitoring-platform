# Copy this file to .env and adjust. NEVER commit .env (it is in .gitignore).

# Linux only: set to the output of `id -u`. Mac/Windows can leave 50000.
AIRFLOW_UID=50000

# Airflow login for http://localhost:8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_SECRET_KEY=change-this-to-any-long-random-string

# Events generated per daily DAG run. Start small (100000), use 5000000 for the benchmark.
NUM_EVENTS=100000

# Memory for Spark inside the scheduler container. Use 4g for 5M events.
SPARK_DRIVER_MEMORY=2g

# Fail validation if more than this share of rows is invalid.
MAX_INVALID_RATIO=0.10

# Storage: "local" (./data folder) or "s3" (Amazon S3, see docs/AWS_SETUP.md)
STORAGE_MODE=local
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
